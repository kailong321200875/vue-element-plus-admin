{
  "name": "vue-element-plus-admin",
  "version": "2.9.0",
  "description": "一套基于vue3、element-plus、typesScript、vite4的后台集成方案。",
  "author": "Archer <502431556@qq.com>",
  "private": false,
  "type": "module",
  "scripts": {
    "i": "pnpm install",
    "dev:admin": "pnpm --filter @vea/admin dev",
    "build:admin": "pnpm --filter @vea/admin build",
    "build:admin:dev": "pnpm --filter @vea/admin build:dev",
    "build:admin:test": "pnpm --filter @vea/admin build:test",
    "preview:admin": "pnpm --filter @vea/admin preview",
    "typecheck:admin": "pnpm --filter @vea/admin ts:check",
    "clean:admin": "pnpm --filter @vea/admin clean",
    "npm:check": "pnpx npm-check-updates -u",
    "clean": "pnpx rimraf node_modules",
    "clean:cache": "pnpx rimraf node_modules/.cache",
    "lint:eslint": "eslint . --fix \"src/**/*.{js,ts,tsx,vue,html}\"",
    "lint:format": "prettier --write --loglevel warn \"src/**/*.{js,ts,json,tsx,css,less,vue,html,md}\"",
    "lint:style": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged -c ./.husky/lintstagedrc.cjs",
    "prepare": "husky install",
    "p": "plop",
    "icon": "esno ./scripts/icon.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.4.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@zxcvbn-ts/core": "^4.1.2",
    "animate.css": "^4.1.1",
    "axios": "^1.19.0",
    "cropperjs": "^2.1.1",
    "dayjs": "^1.11.21",
    "driver.js": "^1.8.0",
    "echarts": "^6.1.0",
    "element-plus": "2.14.4",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.15.3",
    "vue": "3.5.41",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "11.4.8",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.2.0",
    "vue-types": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.514",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@unocss/transformer-variant-group": "^66.7.5",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "autoprefixer": "^10.5.4",
    "chalk": "^6.0.0",
    "consola": "^3.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "vue-eslint-parser": "^10.4.1",
    "esno": "^4.8.0",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "inquirer": "^14.0.2",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "mockjs": "^1.1.0",
    "plop": "^4.0.5",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "terser": "^5.49.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "unocss": "^66.7.5",
    "vite": "8.2.1",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-mock": "3.0.2",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-purge-icons": "^0.10.0",
    "vite-plugin-style-import": "2.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-url-copy": "^1.1.4",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=8.1.0"
  },
  "license": "MIT",
